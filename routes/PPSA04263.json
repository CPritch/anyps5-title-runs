{
  "title_id": "PPSA04263",
  "name": "The prologue (a new game, no save)",
  "scene": "Story Mode, Resume Story: the loaded scene (the bank)",
  "source": "CPritch/gtav-harness nav.sh nav_to_resume and nav_wait_loaded (ef6636d); frame states from frame_state.py",
  "dump_every": 30,
  "timed_stop_after": "resume",
  "steps": [
    {"wait": {"state": "title"}, "timeout": 900, "fail": "no title screen"},
    {"wait": {"stable": "title", "checks": 5}, "timeout": 60, "fail": "title screen not stable"},
    {"log": "title"},
    {"press": "cross", "until": {"left": "title"}, "within": 10, "tries": 6, "fail": "title did not advance"},
    {"if": {"state": "calibration"}, "within": 5, "then": [
      {"log": "calibration"},
      {"press": "cross", "until": {"left": "calibration"}, "within": 15, "tries": 3, "fail": "calibration did not advance"}
    ]},
    {"wait": {"stable": "colour", "checks": 3}, "timeout": 120, "fail": "no landing page"},
    {"log": "landing"},
    {"repeat": 2, "steps": [
      {"press": "r1", "until": {"change": true}, "within": 10, "tries": 3, "fail": "tab did not change"},
      {"sleep": 1}
    ]},
    {"log": "story tab"},
    {"press": "cross", "until": {"state": "black"}, "within": 30, "tries": 3, "fail": "Resume Story did not start a load"},
    {"mark": "resume"},
    {"loaded": {"after": "resume", "max_p50_ms": 1000, "not_state": "black"}, "timeout": 900},
    {"mark": "loaded"}
  ]
}
